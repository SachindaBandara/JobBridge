# --- Blogger ---
BLOGGER_BLOG_ID=1234567890123456789
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# --- Fetching (identify your bot honestly; include a contact) ---
BOT_USER_AGENT=Job2BloggerBot/1.0 (+https://yourblog.blogspot.com; contact: you@example.com)

# --- Optional AI summaries via Google Gemini (key from https://aistudio.google.com/apikey; leave empty to disable) ---
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_IMAGE_MODEL=gemini-nano-banana-2.1
